SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-server-side-key
# Optional: comma-separated origins allowed to call the API from the browser
CORS_ORIGINS=http://localhost:5173,https://your-frontend-domain.pages.dev
# Optional: set this when the API is served from a different domain than the frontend
PUBLIC_API_BASE_URL=https://your-backend.onrender.com
